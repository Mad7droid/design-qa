{
  "manifest_version": 3,
  "name": "Hyper Spec",
  "version": "1.1.0",
  "description": "Select elements on any live page, note what to change, and export a precise spec for Claude Code, Codex, or your team.",
  "minimum_chrome_version": "116",
  "permissions": [
    "scripting",
    "storage",
    "sidePanel",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Hyper Spec",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {"matches": ["<all_urls>"], "js": ["hotkeys.js"], "run_at": "document_idle"}
  ],
  "commands": {
    "_execute_action": {"suggested_key": {"default": "Alt+Shift+Q"}, "description": "Open Hyper Spec"},
    "select-element": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Select an element on the page"},
    "capture-page": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Capture the visible page"}
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'none'"
  }
}
